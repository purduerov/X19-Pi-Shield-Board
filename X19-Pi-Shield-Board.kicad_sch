	(text "your load caps should be by the crystal, not by the IC"
		(exclude_from_sim no)
		(at 119.126 59.436 0)
		(effects
			(font
				(size 1.27 1.27)
			)
		)
		(uuid "074e9606-a211-495d-aabf-606130034d12")
	)
	(text "both of your SPI chips have the same CS net\nthis will cause both to be activated at the same time and neither to work\nonce the above comment is done, the CS nets should be PI_CS and STM_CS"
		(exclude_from_sim no)
		(at 234.95 102.616 0)
		(effects
			(font
				(size 1.27 1.27)
			)
		)
		(uuid "0a79f8d8-0b9e-47c5-9222-5d47d1f39f87")
	)
	(text "your osc_in and osc_out nets are the same for both the stm and the can controller\nthat will cause neither to work\nyou need two crystals and two sets of nets, one for each IC"
		(exclude_from_sim no)
		(at 161.544 72.898 0)
		(effects
			(font
				(size 1.27 1.27)
			)
		)
		(uuid "5bfafde2-1dcd-4332-b8af-bacde12cb23b")
	)
	(text "this has no connection to any IC so the clock would not be able to be used\n(and it also isn't generated anyway rn bc the crystal needs OSC_OUT from the IC to create the clock signal on OSC_IN)\neach in/out pin should be connected to osc_in/osc_out\n\nwould also recommend using the built-in kicad crystal footprint (Crystal_GND24)"
		(exclude_from_sim no)
		(at 246.38 160.02 0)
		(effects
			(font
				(size 1.27 1.27)
			)
		)
		(uuid "6bcfb63f-b1e2-4e97-8955-7869df3d5c82")
	)
	(text "the power monitor IC and sensor (BME280) should be on the STM's SPI and I2C interfaces\nthe only thing on the pi should be the CAN controller SPI"
		(exclude_from_sim no)
		(at 236.728 94.742 0)
		(effects
			(font
				(size 1.27 1.27)
			)
		)
		(uuid "844ca426-275b-4215-8cc4-321802c3e996")
	)
	(text "this ALERT signal, connected to net named GPIO, is not connected to anything\nwould rename to something like PWR_MON_ALERT and connect to pi pin"
		(exclude_from_sim no)
		(at 20.574 56.134 0)
		(effects
			(font
				(size 1.27 1.27)
			)
		)
		(uuid "a5ff4c0b-811f-40b5-b47d-a202634c7b37")
	)
	(text "could add \"no connect\" indicators on unused pins here\n\"x\" icon on sidebar or press Q"
		(exclude_from_sim no)
		(at 35.306 66.04 0)
		(effects
			(font
				(size 1.27 1.27)
			)
		)
		(uuid "aa5d559a-b02b-469b-ac44-750a466e54fe")
	)
